{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fix": "$npm_execpath run format && $npm_execpath run lint:fix",
    "check": "$npm_execpath run lint && $npm_execpath run test"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "vite": "^8.1.3",
    "wrangler": "^4.109"
  }
}
