{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-alive-satooru-me",
  "compatibility_date": "2026-09-30",
  "main": "./src/index.tsx",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "api-alive-satooru-me",
      "database_id": "2d2a3130-70f8-4e0d-8766-efb8b6074807",
    },
  ],
  // ページを開いているクライアントに心拍の保存を WebSocket で通知する
  "durable_objects": {
    "bindings": [
      {
        "name": "HEART_RATE_BROADCASTER",
        "class_name": "HeartRateBroadcaster",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HeartRateBroadcaster"],
    },
  ],
  "routes": [
    {
      "pattern": "alive.satooru.me",
      "custom_domain": true,
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
